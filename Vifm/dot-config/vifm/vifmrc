set vicmd=nvim
set syscalls
set trash
set nofollowlinks
set dotdirs=treeleafsparent
set nowrap

set fastrun
set norunexec

set history=100
set undolevels=100

set sortnumbers

colorscheme master

fileviewer {*.gz,*.bz2,*.xz,*.tar,*.tgz,*.tbz2,*.rpm,*.deb}
    \ tar -tvf %c

fileviewer {*.jpg,*.jpeg,*.png,*.gif,*.tiff,*.bmp,*.webp,*.xpm}
    \ wezterm imgcat --tmux-passthru detect --width %pw --height %ph --position %px$(printf '\054')%py %c >/dev/tty </dev/tty %N

fileviewer {*}
    \ bat --color=always --decorations=always --paging=never -- %c

set timefmt=%d.%m.%y\ %H:%M

set wildmenu
set wildstyle=popup
set suggestoptions=normal,visual,view,otherpane,keys,marks,registers

set ignorecase
set smartcase
set nohlsearch
set incsearch

set scrolloff=4
set statusline="  Hint: %z%= %A %10u:%-7g %15s %20d  "

mark h ~/

only
set millerview milleroptions+="rpreview:all"
