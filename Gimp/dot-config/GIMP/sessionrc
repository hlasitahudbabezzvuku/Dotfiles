# GIMP sessionrc
# 
# This file takes session-specific info (that is info, you want to keep
# between two GIMP sessions).  You are not supposed to edit it manually, but
# of course you can do.  The sessionrc will be entirely rewritten every time
# you quit GIMP.  If this file isn't found, defaults are used.

(session-info "toplevel"
    (factory-entry "gimp-empty-image-window")
    (position 0 0)
    (size 1682 944)
    (monitor 0))
(session-info "toplevel"
    (factory-entry "gimp-single-image-window")
    (position 0 0)
    (size 1900 988)
    (monitor 0)
    (open-on-exit)
    (aux-info
        (left-docks-width "415")
        (right-docks-width "408")
        (maximized "no"))
    (gimp-toolbox
        (side left))
    (gimp-dock
        (side left)
        (position 52)
        (book
            (current-page 0)
            (dockable "gimp-tool-options"
                (tab-style preview)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-tool-preset-list"
                (tab-style preview)
                (aux-info
                    (show-button-bar "true")))))
    (gimp-dock
        (side right)
        (book
            (current-page 0)
            (dockable "gimp-histogram-editor"
                (tab-style icon))
            (dockable "gimp-dashboard"
                (tab-style icon)
                (aux-info
                    (show-button-bar "true"))))
        (book
            (position 426)
            (current-page 1)
            (dockable "gimp-layer-list"
                (tab-style icon)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-undo-history"
                (tab-style icon)
                (aux-info
                    (show-button-bar "true"))))))
(session-info "toplevel"
    (factory-entry "gimp-preferences-dialog")
    (position 56 50)
    (size 1258 896)
    (monitor 0))
(session-info "toplevel"
    (factory-entry "gimp-keyboard-shortcuts-dialog")
    (position 56 50)
    (size 1078 290)
    (monitor 0))
(session-info "toplevel"
    (factory-entry "gimp-toolbox-color-dialog")
    (position 56 50))
(session-info "toplevel"
    (factory-entry "gimp-file-open-dialog")
    (position 20 20)
    (size 1265 941))
(session-info "toplevel"
    (factory-entry "gimp-operation-tool-dialog")
    (position 56 50)
    (monitor 0))
(session-info "toplevel"
    (factory-entry "gimp-curves-tool-dialog")
    (position 56 50)
    (size 504 583)
    (monitor 0))
(session-info "toplevel"
    (factory-entry "gimp-file-export-dialog")
    (position 20 20)
    (size 1265 941)
    (monitor 0))

(hide-docks no)
(single-window-mode yes)
(show-tabs yes)
(tabs-position 1)
(last-tip-shown 0)

# end of sessionrc
